# ── Dependencias (SIEMPRE fuera del repo: se instalan con npm ci) ───────────
node_modules/
.pnp
.pnp.js

# ── Expo: cachés y salidas de desarrollo ────────────────────────────────────
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
# Produce automáticamente .vscode/settings.json con la extensión de Expo
.vscode/**/*
!.vscode/extensions.json

# ── Proyectos nativos GENERADOS (expo prebuild los crea en CI) ──────────────
# El JS no los necesita: app.json + las dependencias son la fuente de verdad.
android/
ios/

# ── Node / bundlers ─────────────────────────────────────────────────────────
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
*.tsbuildinfo

# ── Secretos y variables de entorno: NUNCA al repo ──────────────────────────
.env
.env.*
!.env.example

# ── Firmas de publicación (EAS / Play Store): NUNCA al repo ─────────────────
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
credentials.json

# ── EAS: estado local del CLI ───────────────────────────────────────────────
.eas/
.easignore

# ── Tests ───────────────────────────────────────────────────────────────────
coverage/

# ── Sistema operativo ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
